{
  "name": "paragraph-app",
  "version": "1.0.0",
  "description": "Простое приложение для добавления параграфов с полной настройкой CI/CD",
  "main": "src/script.js",
  "scripts": {
  
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "start": "webpack serve --mode development --open",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js __tests__/**/*.js",
    "lint:fix": "eslint src/**/*.js __tests__/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,html,css}\" \"__tests__/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\" \"__tests__/**/*.js\"",
    "pre-commit": "npm run lint && npm run test && npm run format:check",
    "clean": "rm -rf dist",
    "prepare": "husky install"
  },

  "devDependencies": {
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.8",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3"
  },
  
  "lint-staged": {
    "**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{html,css,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "javascript",
    "webpack",
    "jest",
    "eslint",
    "prettier",
    "ci-cd",
    "github-pages"
  ],
  "author": "Beginner Developer",
  "license": "MIT"
}