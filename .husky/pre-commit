#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Для новичка: этот скрипт выполняется автоматически перед каждым коммитом

echo "🚀 Запуск прекоммит-проверок..."

# Запускаем lint-staged который запустит ESLint и Prettier для файлов в коммите
npx lint-staged

# Запускаем тесты чтобы убедиться что ничего не сломалось
npm test

echo "✅ Все проверки пройдены! Можно коммитить."